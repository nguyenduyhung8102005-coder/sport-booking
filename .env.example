# Sao chép file này thành ".env" (đã nằm trong .gitignore, KHÔNG commit) rồi điền thông tin
# sandbox VNPay nhận qua email sau khi đăng ký tại https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Địa chỉ VNPay chuyển TRÌNH DUYỆT của khách về sau khi thanh toán (chỉ để hiển thị kết quả)
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return

# --- Chỉ cần khi chạy profile prod (SPRING_PROFILES_ACTIVE=prod): thiếu là app KHÔNG khởi động ---
# JWT_SECRET=          # tạo bằng: openssl rand -base64 32
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
